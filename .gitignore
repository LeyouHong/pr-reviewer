# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Benchmark artifacts.
#
# The run directories hold per-PR findings; the root-level logs hold the file
# paths, identifiers and behaviour of whatever repository was reviewed. Both
# describe someone else's code, so neither belongs in this repository for the
# same reason corpus.json does not.
benchmark_runs/
runs/
runs-*.log
*.log

# Corpus and candidate findings.
#
# These are DERIVED artifacts that embed the full source diffs of whatever
# repository they were captured from, plus unfixed security findings about it.
# Capturing from a private repo means this file carries someone else's private
# code, so it is never committed. Rebuild with:
#   pr-reviewer benchmark-capture --repo <owner/name> <pr numbers...>
corpus.json
candidates.json

# Local env
.env
.env.local

# Local tooling state
.codebase-memory/
corpus_retired.json
crb_corpus.json
crb_smoke.json

# Regenerated from docs/architecture.html by docs/build.sh
docs/*.pdf
aacr_raw.json
aacr_cases*.json
