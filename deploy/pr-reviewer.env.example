# Copy to /etc/pr-reviewer/pr-reviewer.env, chmod 600, chown to the service user.
# Kept out of the unit files because those are world-readable.

DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
GITHUB_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# gh reads this. A fine-grained PAT with pull-requests:write on the repositories
# under review is enough — the reviewer never pushes.
GH_TOKEN=ghp_xxxxxxxxxxxxxxxx

# Stamped into every posted report so a comment traces back to the build.
COMMIT_HASH=
